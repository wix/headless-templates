---
// Site chrome for every page: the header (wordmark, Buy, Rent, Sell, Agents, Neighborhoods, About, and the one action, Contact), the footer, and the
// closing call to action above the footer on every page but Contact. Everything the owner edits is read live from the CMS.
//   closing  the closing "Contact Us" band above the footer, on by default (off on /contact, where the page is the form).
//   title    ONLY for pages Wix does not resolve SEO tags for (listing, agent and neighborhood detail pages, legal pages, 404). Main pages get their
//            <title> and description injected by Wix (dashboard > SEO), so a fallback here would duplicate them.
import { getChrome } from "../lib/chrome";
import { NAV, SITE_NAME_FALLBACK } from "../lib/site";
import { getListings, getCategories, isActive, imgSrc } from "../lib/cms";
import SocialBar from "../components/SocialBar.astro";
import "../styles/global.css";

interface Props { title?: string; closing?: boolean }
const { title, closing = true } = Astro.props;

const { copy, social, legal } = await getChrome();
const site = copy.site?.title ?? SITE_NAME_FALLBACK;
const f = copy.footer;
const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  const [hp, hq] = href.split("?");
  if (hq) return path === hp && Astro.url.searchParams.get("category") === new URLSearchParams(hq).get("category");   // Buy / Rent share /listings
  if (hp === "/listings") return false;
  return path === hp || path.startsWith(`${hp}/`);
};
const addr = (f?.body ?? "").split("\n").filter(Boolean);
const bits = (f?.bodySecondary ?? "").split("·").map((x) => x.trim()).filter(Boolean);
// The footer's photo card: the latest sold or rented listing (falls back to the first listing).
// Footer cards: Buy and Rent (the categories, with their active listing counts and their first listing's photo) and Sell (the Sell page,
// with the Sell block's photo or another listing's).
const [all, cats] = await Promise.all([getListings(), getCategories()]);
const active = all.filter(isActive);
const catCard = (slug: string) => {
  const c = cats.find((x) => x.slug === slug); if (!c) return null;
  const rows = active.filter((l) => l.category === c._id);
  return { title: c.title, href: `/listings?category=${slug}`, count: rows.length, note: `${rows.length} ${rows.length === 1 ? "listing" : "listings"}`, action: "View listings", img: imgSrc(rows[0]?.image, 800, 600) };
};
const footCards = [catCard("buy"), catCard("rent"),
  { title: copy.sell?.title?.replace(/\s+with us$/i, "") || "Sell", href: "/sell", count: null as number | null, note: copy.sell?.ctaLabel ?? "Get a free valuation", action: copy.sell?.ctaLabel ?? "Get a free valuation", img: imgSrc(copy.sell?.image || all[all.length - 1]?.image, 800, 600) },
].filter((x): x is NonNullable<typeof x> => !!x);
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Focus rings only for keyboard use: Tab turns them on, any pointer press turns them off (no ring after a click anywhere). -->
    <script is:inline>
      addEventListener("keydown", function (e) { if (e.key === "Tab") document.documentElement.classList.add("kbd"); }, true);
      addEventListener("pointerdown", function () { document.documentElement.classList.remove("kbd"); }, true);
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {title && <title>{`${title} | ${site}`}</title>}
    <link rel="icon" href="/favicon.svg" />
    <slot name="seo-tags" />
    <script is:inline>
      // Page transitions: skipped when only the query changes on the same page (pagination, filters, sort, search) — the transition is for
      // moving between pages, not for paging through one list. Runs on both sides of the navigation.
      (function () {
        var same = function (a, b) { try { var x = new URL(a), y = new URL(b); if (x.pathname !== y.pathname || x.searchParams.get("page") === y.searchParams.get("page")) return false; x.searchParams.delete("page"); y.searchParams.delete("page"); x.searchParams.sort(); y.searchParams.sort(); return x.search === y.search; } catch (e) { return false; } };
        addEventListener("pageswap", function (e) { if (e.viewTransition && e.activation && e.activation.entry && same(e.activation.entry.url, location.href)) e.viewTransition.skipTransition(); });
        addEventListener("pagereveal", function (e) { var a = window.navigation && navigation.activation; if (e.viewTransition && a && a.from && same(a.from.url, location.href)) e.viewTransition.skipTransition(); });
      })();
    </script>
  </head>
  <body class="min-h-svh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:bg-background focus:px-4 focus:py-3">Skip to content</a>

    <!-- Header: one grey pill centred on the page holding the wordmark, the links (hairline dividers between them) and the Contact button. -->
    <header class="sticky top-0 z-30">
      <div class="wrap relative flex h-(--header-h) items-center justify-center">
        <div class="head-pill">
          <a href="/" class="head-logo"><span class="truncate">{site}</span></a>
          <nav aria-label="Main" class="head-nav hidden lg:flex">
            {NAV.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined} class="nav-link">{n.label}</a>)}
          </nav>
          <div class="flex shrink-0 items-center gap-1">
            <a href="/contact" class="btn btn-primary head-cta" aria-current={isCurrent("/contact") ? "page" : undefined}>Contact</a>
            <button type="button" id="menu-btn" class="icon-btn h-9 w-9 bg-background lg:hidden" aria-expanded="false" aria-controls="menu-panel" aria-label="Menu">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path id="menu-open" d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /><path id="menu-close" class="hidden" d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
            </button>
          </div>
        </div>
      </div>
      <div id="menu-panel" class="panel lg:hidden" hidden>
        <nav aria-label="Menu" class="wrap py-2">
          <ul>
            {NAV.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined} class="flex min-h-12 items-center border-b border-border text-lg font-medium text-foreground no-underline">{n.label}</a></li>)}
          </ul>
          <a href="/contact" class="btn btn-primary my-4 w-full">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- Footer: an ink block. The name, intro and pages on the left, the follow links top right; then Buy, Rent and Sell as large photo
         cards; then the address, hours and contact in one row; then credit and legal links. -->
    <footer class="site-foot bg-inverse text-inverse-foreground">
      <!-- Buy, Rent and Sell as large cards (the home page's category cards, smaller and on ink): name and count above a 4:3 photo. -->
      <ul class="cat-grid foot-cats wrap">
        {footCards.map((c) => (
          <li><a href={c.href} class="cat-card">
            <span class="cat-top">
              <span class="cat-name">{c.title}</span>
              <span class="cat-btn2">
                <span class="cat-rest">{c.note}<span aria-hidden="true"> →</span></span>
                <span class="cat-pill" aria-hidden="true">{c.action}{c.count != null && <span class="cat-pill-count">{c.count}</span>}</span>
              </span>
            </span>
            <span class="cat-photo">{c.img && <img src={c.img} alt="" width="800" height="600" loading="lazy" />}</span>
          </a></li>
        ))}
      </ul>
      <!-- On the card grid above: the name, intro and social icons, a hairline, then the site map in the first column with the
           address, phone and e-mail in the second and the opening hours in the third, all starting on the site map's first line. -->
      <div class="wrap foot-top foot-grid">
        <div class="ft-brand">
          <p class="font-display text-lg font-bold">{f?.title ?? site}</p>
          {copy.site?.body && <p class="mt-3 max-w-[40ch] text-sm text-inverse-muted">{copy.site.body}</p>}
          {social.length > 0 && (<div class="mt-6"><h2 class="sr-only">Follow Us</h2><SocialBar links={social} class="-ml-3" /></div>)}
        </div>
        <div class="ft-rule" aria-hidden="true"></div>
        <nav aria-label="Pages" class="ft-nav">
          <h2 class="sr-only">Pages</h2>
          <ul class="foot-links">
            <li><a href="/">Home</a></li>
            {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </nav>
        <div class="ft-contact ft-c1">
          <address class="not-italic">{addr.map((l) => <p>{l}</p>)}</address>
          {bits.length > 0 && <p class="mt-5 flex flex-col items-start">{bits.map((b) => <a class="text-inverse-foreground transition-opacity hover:opacity-60" href={b.includes("@") ? `mailto:${b}` : `tel:${b.replace(/[^\d+]/g, "")}`}>{b}</a>)}</p>}
        </div>
        <div class="ft-contact ft-c2">{f?.hours && <p class="whitespace-pre-line">{f.hours}</p>}</div>
      </div>
      <!-- Bottom row, set apart: legal pages, the credit line under them. -->
      <div class="wrap foot-legal">
        {legal.length > 0 ? (
          <nav aria-label="Legal"><ul class="-ml-3 flex flex-wrap">{legal.map((p) => <li><a href={`/policies/${p.slug}`} class="inline-flex min-h-11 items-center px-3 text-inverse-foreground no-underline transition-opacity hover:opacity-60">{p.title}</a></li>)}</ul></nav>
        ) : <span />}
        <p class="foot-credit">{f?.credit ?? "© 2035 by Business Name. Built with Wix Headless"}</p>
      </div>
    </footer>

    <script is:inline>
      // The phone menu: a disclosure. Escape, a tap outside or a link closes it; the button keeps aria-expanded in step.
      (function () {
        var mb = document.getElementById("menu-btn"), mp = document.getElementById("menu-panel");
        function set(open) {
          mp.hidden = !open; mb.setAttribute("aria-expanded", String(open)); mb.setAttribute("aria-label", open ? "Close menu" : "Menu");
          document.getElementById("menu-open").classList.toggle("hidden", open); document.getElementById("menu-close").classList.toggle("hidden", !open); document.documentElement.classList.toggle("menu-open", open);
        }
        mb.addEventListener("click", function () { set(mp.hidden); });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !mp.hidden) { set(false); mb.focus(); } });
        document.addEventListener("click", function (e) { if (!mp.hidden && !mp.contains(e.target) && !mb.contains(e.target)) set(false); });
        window.matchMedia("(min-width: 1024px)").addEventListener("change", function (m) { if (m.matches) set(false); });
        // A list's sort select submits its form on change (the form still works without JS: it has a Search button).
        // Wordmarks ([data-fit]) fill their container's width on one line, as the reference's; too small (under 40px) and they wrap instead.
        function fit() {
          document.querySelectorAll("[data-fit]").forEach(function (el) {
            var span = el.firstElementChild; if (!span) return;
            el.style.fontSize = ""; el.classList.remove("fit-wrap");
            var cs = getComputedStyle(el), w = el.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
            var size = parseFloat(cs.fontSize) * w / span.getBoundingClientRect().width * 0.995;
            // The fitted size goes in --fit; --shrink (set by a page's scroll effect, default 1) scales it.
            if (size < 40) el.classList.add("fit-wrap"); else { el.style.setProperty("--fit", size + "px"); el.style.fontSize = "calc(var(--fit) * var(--shrink, 1))"; }
          });
        }
        (document.fonts ? document.fonts.ready : Promise.resolve()).then(fit);
        var ft; window.addEventListener("resize", function () { clearTimeout(ft); ft = setTimeout(fit, 120); });
        // Section headings (every visible H2): a square mark before the text, and a scroll-driven reveal — each word is a mask, each
        // letter rises into it as the heading comes up the screen, one after another from the left (the mark first, then the letters); done once the heading's top is a third of the way up the screen; scrolling back lowers them again.
        (function () {
          var still = matchMedia("(prefers-reduced-motion: reduce)").matches, heads = [];
          document.querySelectorAll("h2").forEach(function (h) {
            if (h.classList.contains("sr-only") || h.id === "filters-title" || h.classList.contains("frame-words") || h.children.length) return;
            var text = h.textContent.replace(/\s+/g, " ").trim(); if (!text) return;
            h.setAttribute("aria-label", text); h.textContent = ""; h.classList.add("h2-split");
            var parts = [];   // no square mark before headings any more
            text.split(" ").forEach(function (word) {
              h.appendChild(document.createTextNode(" "));
              var m = document.createElement("span"); m.className = "h2w"; m.setAttribute("aria-hidden", "true");
              for (var i = 0; i < word.length; i++) { var c = document.createElement("span"); c.className = "h2c"; c.textContent = word[i]; m.appendChild(c); parts.push(c); }
              h.appendChild(m);
            });
            heads.push({ el: h, parts: parts });
          });
          if (still || !heads.length) return;
          var raf = 0;
          function update() {
            raf = 0;
            heads.forEach(function (o) {
              var r = o.el.getBoundingClientRect(), vh = innerHeight;
              var p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.4)));   // 0 as it enters at the bottom → 1 at 60% of the screen
              var n = o.parts.length, span = 0.5, step = n > 1 ? (1 - span) / (n - 1) : 0;
              for (var i = 0; i < n; i++) {
                var t = Math.min(1, Math.max(0, (p - i * step) / span)); t = t * t * (3 - 2 * t);   // left to right: the mark first
                var y = (1 - t) * 105; o.parts[i].style.transform = y > 0.05 ? "translateY(" + y.toFixed(2) + "%)" : "";
              }
            });
          }
          addEventListener("scroll", function () { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
          addEventListener("resize", update); update();
        })();
        // Card lists (category cards, listing grids): as each row of a list comes up the screen its cards start stepped — each column lower than
        // the one before by 80px (photo and text together) — and line up as the scroll goes on; a row is aligned once its top is 60% of
        // the way up the screen. Scrolling back steps them again.
        (function () {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var lists = [].slice.call(document.querySelectorAll(".cat-grid, ul:has(> li > .lcard)")); if (!lists.length) return;
          var raf = 0, STEP = 80;
          function cols(ul) {   // column index of each item: its rank among the items on its row
            var items = [].slice.call(ul.children), rows = {};
            items.forEach(function (li) { var t = Math.round(li.offsetTop / 10); (rows[t] = rows[t] || []).push(li); });
            Object.keys(rows).forEach(function (k) { rows[k].sort(function (a, b) { return a.offsetLeft - b.offsetLeft; }).forEach(function (li, i) { li._col = i; }); });
          }
          function update() {
            raf = 0;
            var vh = innerHeight;
            lists.forEach(function (ul) {
              // Each row runs on its own: progress from the row's own top (the item's top without its current shift).
              [].forEach.call(ul.children, function (li) {
                var top = li.getBoundingClientRect().top - (li._y || 0);
                var p = Math.min(1, Math.max(0, (vh - top) / (vh * 0.6))); p = p * p * (3 - 2 * p);
                var y = innerWidth < 1024 ? 0 : (li._col || 0) * STEP * (1 - p); li._y = y;   // tablet and phone: no stepping
                li.style.transform = y > 0.5 ? "translateY(" + y.toFixed(1) + "px)" : "";
              });
            });
          }
          function layout() { lists.forEach(cols); update(); }
          addEventListener("scroll", function () { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
          addEventListener("resize", layout); addEventListener("load", layout); layout();
        })();
        document.querySelectorAll("[data-autosubmit]").forEach(function (el) { el.addEventListener("change", function () { el.form.requestSubmit ? el.form.requestSubmit() : el.form.submit(); }); });
      })();
    </script>
    <!-- Hover only where it makes sense: on desktop (from 1024px, with a mouse). Every :hover rule in the site's stylesheets is scoped
         to html.can-hover, which is on only there, so tablets and phones never show (or get stuck on) a hover state. -->
    <script is:inline>
      (function () {
        var mq = matchMedia("(min-width: 1024px) and (hover: hover) and (pointer: fine)"), root = document.documentElement;
        function set() { root.classList.toggle("can-hover", mq.matches); }
        set(); (mq.addEventListener ? mq.addEventListener("change", set) : mq.addListener(set));
        function scope(rules) {
          for (var i = 0; i < rules.length; i++) {
            var r = rules[i];
            if (r.selectorText && r.selectorText.indexOf(":hover") > -1 && r.selectorText.indexOf("can-hover") < 0) {
              r.selectorText = r.selectorText.split(/,(?![^(]*\))/).map(function (s) { s = s.trim(); return s.indexOf(":hover") > -1 ? "html.can-hover " + s : s; }).join(", ");
            }
            if (r.cssRules) scope(r.cssRules);
          }
        }
        function run() { [].forEach.call(document.styleSheets, function (sh) { try { scope(sh.cssRules); } catch (e) {} }); }
        run(); addEventListener("load", run);
      })();
    </script>
    <!-- Dropdowns: every <select class="field"> gets a button and a list in the site's menu style (white rounded panel, soft shadow, grey
         hover row). The native select stays in the form, hidden, and is kept in sync both ways: a pick sets it and fires "change" (so
         auto-submit and the filters' own scripts work); code that rewrites its options or sets its value repaints the button. Keyboard:
         Enter / Space / arrows open it, arrows move, Enter picks, Escape or Tab closes. -->
    <script is:inline>
      (function () {
        var openDd = null;
        function close(dd, focus) { if (!dd) return; dd.el.classList.remove("is-open"); dd.btn.setAttribute("aria-expanded", "false"); if (focus) dd.btn.focus(); if (openDd === dd) openDd = null; }
        function enhance(sel) {
          if (sel.dataset.dd) return; sel.dataset.dd = "1";
          var el = document.createElement("div"); el.className = "sx";
          sel.parentNode.insertBefore(el, sel); el.appendChild(sel); sel.classList.add("sx-native"); sel.tabIndex = -1; sel.setAttribute("aria-hidden", "true");
          var btn = document.createElement("button"); btn.type = "button";
          btn.className = sel.className.replace("sx-native", "").trim() + " sx-btn";
          btn.setAttribute("aria-haspopup", "listbox"); btn.setAttribute("aria-expanded", "false");
          var lab = sel.id && document.querySelector('label[for="' + sel.id + '"]');
          if (lab) { lab.id = lab.id || sel.id + "-lab"; btn.setAttribute("aria-labelledby", lab.id + " " + sel.id + "-btn"); lab.addEventListener("click", function (e) { e.preventDefault(); btn.focus(); }); }
          btn.id = sel.id ? sel.id + "-btn" : "";
          var val = document.createElement("span"); val.className = "sx-val"; btn.appendChild(val);
          var list = document.createElement("ul"); list.className = "sx-list"; list.setAttribute("role", "listbox"); list.tabIndex = -1;
          el.appendChild(btn); el.appendChild(list);
          var dd = { el: el, btn: btn, list: list, sel: sel, active: -1 };
          function items() { return [].slice.call(list.children); }
          function paint() {
            var o = sel.options[sel.selectedIndex]; val.textContent = o ? o.text : "";
            items().forEach(function (li, i) { li.setAttribute("aria-selected", String(i === sel.selectedIndex)); });
          }
          function build() {
            list.innerHTML = "";
            [].forEach.call(sel.options, function (o, i) {
              var li = document.createElement("li"); li.setAttribute("role", "option"); li.className = "sx-opt"; li.textContent = o.text; li.dataset.i = i;
              if (o.disabled) li.setAttribute("aria-disabled", "true");
              list.appendChild(li);
            });
            paint();
          }
          function setActive(i) { var all = items(); dd.active = Math.max(0, Math.min(all.length - 1, i)); all.forEach(function (li, k) { li.classList.toggle("is-active", k === dd.active); }); var a = all[dd.active]; if (a) a.scrollIntoView({ block: "nearest" }); }
          function open() { if (openDd && openDd !== dd) close(openDd); openDd = dd; el.classList.add("is-open"); btn.setAttribute("aria-expanded", "true"); setActive(sel.selectedIndex); }
          function pick(i) { if (i < 0 || i >= sel.options.length || sel.options[i].disabled) return; var changed = sel.selectedIndex !== i; sel.selectedIndex = i; paint(); close(dd, true); if (changed) sel.dispatchEvent(new Event("change", { bubbles: true })); }
          btn.addEventListener("click", function () { el.classList.contains("is-open") ? close(dd) : open(); });
          list.addEventListener("mousemove", function (e) { var li = e.target.closest(".sx-opt"); if (li) setActive(+li.dataset.i); });
          list.addEventListener("click", function (e) { var li = e.target.closest(".sx-opt"); if (li) pick(+li.dataset.i); });
          btn.addEventListener("keydown", function (e) {
            var isOpen = el.classList.contains("is-open");
            if (e.key === "ArrowDown" || e.key === "ArrowUp") { e.preventDefault(); if (!isOpen) open(); else setActive(dd.active + (e.key === "ArrowDown" ? 1 : -1)); }
            else if (e.key === "Enter" || e.key === " ") { e.preventDefault(); isOpen ? pick(dd.active) : open(); }
            else if (e.key === "Escape" && isOpen) { e.preventDefault(); e.stopPropagation(); close(dd, true); }
            else if (e.key === "Tab" && isOpen) close(dd);
            else if (e.key === "Home" && isOpen) { e.preventDefault(); setActive(0); }
            else if (e.key === "End" && isOpen) { e.preventDefault(); setActive(sel.options.length - 1); }
          });
          // Keep in sync with code that touches the select.
          sel.addEventListener("change", paint);
          new MutationObserver(build).observe(sel, { childList: true, subtree: true });
          ["value", "selectedIndex"].forEach(function (k) {
            var d = Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype, k);
            Object.defineProperty(sel, k, { configurable: true, get: function () { return d.get.call(this); }, set: function (v) { d.set.call(this, v); paint(); } });
          });
          if (sel.form) sel.form.addEventListener("reset", function () { setTimeout(paint, 0); });
          build();
        }
        document.addEventListener("pointerdown", function (e) { if (openDd && !openDd.el.contains(e.target)) close(openDd); }, true);
        function run() { document.querySelectorAll("select.field").forEach(enhance); }
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run); else run();
      })();
    </script>
  </body>
</html>
