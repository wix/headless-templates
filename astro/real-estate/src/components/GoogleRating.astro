---
// A small Google rating badge: the Google "G", the label, the score with five stars filled to the score, and the review count.
// Score and count are the CMS row `rating` (SiteContent: title = score, body = count line); no row, no badge.
interface Props { score?: string; count?: string; name?: string; class?: string; compact?: boolean }
// compact: one line of text above the stars — the CMS count line (e.g. "3K+ Google Maps Reviews") in place of "Google Rating".
const { score, count, name, class: cls = "", compact = false } = Astro.props;
const n = Math.min(5, Math.max(0, parseFloat(score ?? "") || 0));
const star = "M12 2.5l2.94 6.1 6.56.86-4.8 4.56 1.22 6.48L12 17.3l-5.92 3.2 1.22-6.48-4.8-4.56 6.56-.86z";
---
{score && n > 0 && (
  <div class:list={["g-rating", compact && "g-compact", cls]} role="img" aria-label={`Google rating ${n} out of 5${count ? `, ${count}` : ""}`}>
    <svg class="g-logo" viewBox="0 0 48 48" aria-hidden="true">
      <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
      <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
      <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
      <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
    </svg>
    <div class="min-w-0">
      <p class="g-title" aria-hidden="true">{compact && count ? count : "Google Rating"}</p>
      <p class="g-score" aria-hidden="true">
        <span>{n.toFixed(1)}</span>
        <span class="g-stars">
          <span class="g-stars-row">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24"><path d={star} /></svg>)}</span>
          <span class="g-stars-row g-stars-on" style={`width:${(n / 5) * 100}%`}>{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24"><path d={star} /></svg>)}</span>
        </span>
      </p>
      {count && !compact && <p class="g-count" aria-hidden="true">{count}{name ? ` for ${name}` : ""}</p>}
    </div>
  </div>
)}
