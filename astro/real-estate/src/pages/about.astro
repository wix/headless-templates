---
// /about: an intro (title, label and story, wide photo) and a story section (heading, label and text, three tall photos stepping
// down), laid out like the reference; then the numbers and testimonials.
import SiteLayout from "../layouts/SiteLayout.astro";
import { hc } from "../lib/site";
import { getChrome } from "../lib/chrome";
import { getStats, getTestimonials } from "../lib/content";
import { imgSrc, getListings, gallery, paragraphs } from "../lib/cms";

const [{ copy }, stats, testimonials, listings] = await Promise.all([getChrome(), getStats(), getTestimonials(), getListings()]);
const a = copy.aboutPage ?? copy.about;
const story = copy.aboutStory;
const img = imgSrc(a?.image, 2400, 1350);
// Three tall photos for the story: pastel placeholder images from the listings.
const wide2 = (() => { const all = [...new Set(listings.flatMap((l) => [l.image, ...gallery(l)]).filter((x): x is string => !!x))]; return all[7] ? imgSrc(all[7], 2400, 1350) : img; })();
const trio = [...new Set(listings.flatMap((l) => [l.image, ...gallery(l)]).filter((x): x is string => !!x))].slice(3, 6).map((v) => imgSrc(v, 900, 1600));
---
<SiteLayout>
  <!-- 1 · Intro: the title, a rule, the label on the left and the story on the right, then a wide photo. -->
  <section class="section abp abp-first">
    <div class="wrap">
      <h1 class="abp-title text-h2">{hc(a?.title ?? "About Us")}</h1>
      <div class="abp-row">
        <p class="abp-label">{a?.credit ?? "About Us"}</p>
        <div class="abp-copy">
          {[a?.body, ...paragraphs(a?.bodySecondary)].filter(Boolean).map((t) => <p>{t}</p>)}
        </div>
      </div>
      <div class="abp-wide media">{img && <img src={img} alt="" width="2400" height="1350" fetchpriority="high" />}</div>
    </div>
  </section>

  <!-- 2 · Story: the heading, a rule, the label and the text, then three tall photos stepping down. -->
  <section class="section abp">
    <div class="wrap">
      <h2 class="abp-title text-h2">{hc(story?.title ?? "Our Story")}</h2>
      <div class="abp-row">
        <p class="abp-label">{story?.credit ?? "Our Story"}</p>
        <div class="abp-copy">
          {paragraphs(story?.body).map((t) => <p>{t}</p>)}
        </div>
      </div>
      <ul class="abp-trio">{trio.map((t) => <li class="media"><img src={t} alt="" width="900" height="1600" loading="lazy" /></li>)}</ul>
    </div>
  </section>
  {stats.length > 0 && (
    <section class="section bg-secondary">
      <div class="wrap">
        <h2 class="text-h2">{copy.stats?.title ?? "In Numbers"}</h2>
        <dl class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {stats.map((s) => <div class="border-t border-foreground pt-4"><dt class="font-display text-display font-semibold tabular-nums" data-count>{s.value}</dt><dd class="mt-2 text-muted-foreground">{s.label}</dd></div>)}
        </dl>
      </div>
    </section>
  )}
  {wide2 && (
    <!-- Wide photo between two grey sections: grey too, no padding of its own (their padding spaces it, once on each side). -->
    <section class="bg-secondary abp-photo-band" aria-hidden="true">
      <div class="wrap"><div class="abp-wide media" style="margin-top:0"><img src={wide2} alt="" width="2400" height="1350" loading="lazy" /></div></div>
    </section>
  )}
  {testimonials.length > 0 && (
    <!-- Testimonials: the heading with round arrows on the right, then a row of grey cards (title, quote, name) that runs off the right
         edge and scrolls sideways (arrows, swipe or trackpad), snapping card by card. -->
    <section class="section tm bg-secondary" data-tm>
      <div class="wrap">
        <div class="tm-head">
          <h2 class="text-h2">{copy.testimonials?.title ?? "What Clients Say"}</h2>
          <div class="tm-nav">
            <button type="button" class="tm-arrow" data-dir="-1" aria-label="Previous testimonials" disabled><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
            <button type="button" class="tm-arrow" data-dir="1" aria-label="Next testimonials"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
          </div>
        </div>
      </div>
      <ul class="tm-track" tabindex="0" aria-label="Testimonials">
        {testimonials.map((x) => (
          <li class="tm-card">
            {x.title && <h3 class="tm-title">{x.title}</h3>}
            <blockquote class="tm-quote">“{x.quote}”</blockquote>
            <p class="tm-name">{x.name}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</SiteLayout>

<script>
  // Story photos: stepped while the row comes in, one line once its top reaches 40% of the screen.
  const trio = document.querySelector<HTMLElement>(".abp-trio");
  if (trio) {
    const tick = () => {
      const vh = innerHeight, top = trio.getBoundingClientRect().top;
      const p = Math.min(1, Math.max(0, (vh - top) / (vh * 0.6)));
      trio.style.setProperty("--al", String(1 - p));
    };
    addEventListener("scroll", tick, { passive: true }); addEventListener("resize", tick); tick();
  }
  // Testimonials: the arrows scroll the row by one card; each arrow fades out at its end.
  const tm = document.querySelector<HTMLElement>("[data-tm]");
  if (tm) {
    const track = tm.querySelector<HTMLElement>(".tm-track")!;
    const [prevB, nextB] = [...tm.querySelectorAll<HTMLButtonElement>(".tm-arrow")];
    const sync = () => { prevB.disabled = track.scrollLeft < 4; nextB.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4; };
    tm.addEventListener("click", (e) => { const b = (e.target as Element).closest<HTMLElement>("[data-dir]"); if (!b) return; const card = track.querySelector<HTMLElement>(".tm-card")!; track.scrollBy({ left: Number(b.dataset.dir) * (card.offsetWidth + 24), behavior: "smooth" }); });
    track.addEventListener("scroll", sync, { passive: true }); addEventListener("resize", sync); sync();
  }
  // In Numbers: each figure counts up from 0 when it comes into view (prefix, thousands separators and suffix kept, e.g. "$850M").
  const nums = [...document.querySelectorAll<HTMLElement>("[data-count]")];
  const parts = (t: string) => { const m = t.match(/^(\D*)([\d,.]+)(.*)$/); return m ? { pre: m[1], n: parseFloat(m[2].replace(/,/g, "")), comma: m[2].includes(","), dec: (m[2].split(".")[1] || "").length, post: m[3] } : null; };
  const fmt = (p: NonNullable<ReturnType<typeof parts>>, v: number) => p.pre + (p.comma ? v.toLocaleString("en-US", { minimumFractionDigits: p.dec, maximumFractionDigits: p.dec }) : v.toFixed(p.dec)) + p.post;
  if (nums.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const run = (el: HTMLElement) => {
      const p = parts(el.dataset.final!); if (!p) return;
      const t0 = performance.now(), dur = 1600;
      const step = (now: number) => { const k = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - k, 3); el.textContent = fmt(p, p.dec ? p.n * e : Math.round(p.n * e)); if (k < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); run(e.target as HTMLElement); } }), { threshold: 0.4 });
    nums.forEach((el) => { const p = parts(el.textContent!.trim()); if (!p) return; el.dataset.final = el.textContent!.trim(); el.textContent = fmt(p, 0); io.observe(el); });
  }
</script>
