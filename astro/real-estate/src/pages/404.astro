---
// Not found: a way back (Home, the listings, the agents). Also served for an unknown listing, agent, neighborhood or policy.
import SiteLayout from "../layouts/SiteLayout.astro";
Astro.response.status = 404;
---
<SiteLayout title="Page Not Found" closing={false}>
  <section class="section">
    <div class="wrap">
      <div class="page-top">
      <h1 class="text-h2">Page Not Found</h1>
      <p class="mt-4 max-w-[60ch] text-lg text-muted-foreground">The page you are looking for does not exist. Start from the home page or browse the listings.</p>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3"><a href="/" class="btn btn-primary">Home</a><a href="/listings" class="btn btn-secondary">Listings</a><a href="/agents" class="btn btn-secondary">Agents</a></div>
    </div>
  </section>
</SiteLayout>
