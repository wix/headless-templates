---
import Layout from "../layouts/Layout.astro";
import CatalogIsland from "../components/CatalogIsland.jsx";
import { items } from "@wix/data";

let catalogItems = [];
try {
	const { items: rows } = await items
		.query("catalog-items")
		.ascending("category")
		.limit(50)
		.find();
	catalogItems = rows;
} catch (err) {
	// leave catalogItems empty — the island renders an empty state
	console.error("Failed to load catalog-items", err);
}
---


<Layout>
	<CatalogIsland client:load items={catalogItems} />
</Layout>
