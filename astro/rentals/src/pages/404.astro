---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Page Not Found"
  description="The page you're looking for doesn't exist or has been moved."
>
  <Navbar />

  <main class="min-h-screen max-w-3xl mx-auto pt-24 sm:pt-32 pb-16 px-4">
    <section class="glass-panel p-8 md:p-12 text-center animate-fade-up">
      <h1 class="text-6xl font-bold mb-6 text-primary">404</h1>
      <h2 class="text-2xl font-semibold mb-4">Page Not Found</h2>
      <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-block py-3 px-6 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors"
      >
        Go Back Home
      </a>
    </section>
  </main>

  <Footer />
</Layout>
