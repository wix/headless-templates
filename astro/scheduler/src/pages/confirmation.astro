---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { BUSINESS_NAME } from "../utils/constants";
---

<Layout
  title="Appointment Confirmed"
  description="Your appointment has been scheduled — see your booking details."
>
  <Navbar />

  <main class="min-h-screen bg-white max-w-3xl mx-auto pt-24 sm:pt-40 pb-16 px-4">
    <a
      href="/"
      class="inline-flex items-center gap-2 mb-6 text-sm font-medium text-gray-600 hover:text-gray-900"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      Back to Home
    </a>

    <section class="bg-white border border-gray-200 rounded-lg shadow-xs p-8 text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full brand-gradient-card mb-6 animate-scale-in">
        <svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </div>

      <div class="animate-fade-up">
        <p class="eyebrow mb-3">Confirmed</p>
        <h1 class="text-3xl font-normal tracking-tight mb-4">Appointment Confirmed!</h1>
      </div>

      <p class="text-foreground/55 mb-8 max-w-xl mx-auto animate-fade-up delay-100">
        Your appointment has been successfully scheduled with {BUSINESS_NAME}.
        If email notifications are enabled for this site, a confirmation will
        be sent to <span id="confirmation-email">your email</span>.
      </p>

      <div class="bg-secondary/50 p-6 rounded-xs mb-8 inline-block mx-auto animate-fade-up delay-200">
        <div class="flex items-center justify-center gap-3 mb-4">
          <svg class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
            <circle cx="12" cy="15" r="3"></circle>
          </svg>
          <span class="font-medium text-lg">Appointment Details</span>
        </div>

        <div class="text-left space-y-2">
          <p>
            <span class="text-muted-foreground">Name:</span>
            <span id="confirmation-name">Your Name</span>
          </p>
          <p>
            <span class="text-muted-foreground">Date:</span>
            <span id="confirmation-date">Date</span>
          </p>
          <p>
            <span class="text-muted-foreground">Time:</span>
            <span id="confirmation-time">Time</span>
          </p>
          <p>
            <span class="text-muted-foreground">Email:</span>
            <span id="confirmation-email-details">Email</span>
          </p>
          <p>
            <span class="text-muted-foreground">Phone:</span>
            <span id="confirmation-phone">Phone</span>
          </p>
          <p id="confirmation-notes-container" class="hidden">
            <span class="text-muted-foreground">Notes:</span>
            <span id="confirmation-notes">Notes</span>
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-up delay-300">
        <a
          href="/"
          class="px-7 py-3 border-[1.5px] border-primary text-primary pill font-semibold hover:bg-primary/5 transition-colors"
        >
          Return to Home
        </a>
        <a
          href="/schedule"
          class="px-7 py-3 bg-primary text-white pill font-semibold hover:bg-primary/90 transition-colors"
        >
          Book Another Appointment
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import type { BookingData } from "../utils/booking-service";

  function setText(id: string, text: string): void {
    const element = document.getElementById(id);
    if (element) element.textContent = text;
  }

  // Fill the page with the booking details saved before navigating here
  document.addEventListener("DOMContentLoaded", () => {
    const data = sessionStorage.getItem("bookingData");
    if (!data) {
      // Redirect if no booking data is found
      window.location.href = "/schedule";
      return;
    }

    const bookingData = JSON.parse(data) as BookingData;

    setText("confirmation-email", bookingData.email);
    setText("confirmation-name", bookingData.name);
    setText("confirmation-date", bookingData.displayDate || "");
    setText("confirmation-time", bookingData.displayTime || "");
    setText("confirmation-email-details", bookingData.email);
    setText("confirmation-phone", bookingData.phone);

    if (bookingData.notes?.trim()) {
      setText("confirmation-notes", bookingData.notes);
      document
        .getElementById("confirmation-notes-container")
        ?.classList.remove("hidden");
    }
  });
</script>
