---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import DatePicker from "../components/DatePicker.astro";
import TimeSlots from "../components/TimeSlots.astro";
import BookingForm from "../components/BookingForm.astro";
import SessionType from "../components/SessionType.astro";
import ErrorMessage from "../components/ui/ErrorMessage.astro";
import { BUSINESS_NAME } from "../utils/constants";
import {
  getServices,
  toServiceSummaries,
  type ServiceSummary,
} from "../utils/booking-service";

// Fetch the site's bookable services once per request, server-side, and pass them down
let services: ServiceSummary[] = [];
let servicesError = false;
try {
  services = toServiceSummaries(await getServices());
} catch (error) {
  console.error("Error loading services:", error);
  servicesError = true;
}
---

<Layout
  title="Schedule Your Appointment"
  description={`Pick a service, date, and time to book your appointment with ${BUSINESS_NAME}.`}
>
  <Navbar />

  <main class="min-h-screen bg-white max-w-7xl mx-auto pt-24 sm:pt-40 pb-16 px-4">
    <a
      href="/"
      class="inline-flex items-center gap-2 mb-6 text-sm font-medium text-gray-600 hover:text-gray-900"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      Back to Home
    </a>

    <header class="text-center mb-8 animate-fade-up">
      <p class="eyebrow mb-3">Book an Appointment</p>
      <h1 class="text-3xl md:text-5xl font-normal tracking-tight mb-2 text-foreground">
        Schedule Your Appointment
      </h1>
    </header>

    <p class="text-center text-foreground/55 mb-8 max-w-2xl mx-auto animate-fade-up delay-100">
      Select a date and time that works for you, and fill in your details to
      complete the booking with {BUSINESS_NAME}.
    </p>

    <div class="max-w-2xl mx-auto mb-8 animate-fade-up delay-100">
      {servicesError ? (
        <ErrorMessage message="We couldn't load the available services. Please refresh the page to try again." />
      ) : (
        <SessionType services={services} />
      )}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <DatePicker class="animate-fade-up delay-200" />
      <TimeSlots class="animate-fade-up delay-300" />
      <BookingForm class="animate-fade-up delay-400" />
    </div>
  </main>

  <Footer />
</Layout>
