---
// The social bar: Facebook, X, Instagram and YouTube are provisioned (the reference template's four); TikTok, Pinterest, LinkedIn,
// Threads and WhatsApp have icons ready for the owner's own networks. Icon links with 44px targets that open
// in a new tab. The URLs are content (CMS > Social Links), not code. A failed read or an empty collection hides the bar.
import SocialIcon from "./SocialIcon.astro";
import type { SocialLink } from "../lib/content";
interface Props { links: SocialLink[]; class?: string }
const { links, class: cls = "" } = Astro.props;
const LABEL = { facebook: "Facebook", x: "X", instagram: "Instagram", youtube: "YouTube", tiktok: "TikTok", pinterest: "Pinterest", linkedin: "LinkedIn", threads: "Threads", whatsapp: "WhatsApp" } as const;
---
{links.length > 0 && (
  <nav aria-label="Social media" class={cls}>
    <ul class="flex">
      {links.map((l) => (
        <li>
          <a href={l.url} target="_blank" rel="noopener noreferrer" aria-label={`${LABEL[l.platform]} (opens in a new tab)`} class="social-link inline-flex items-center justify-center rounded-full text-current no-underline">
            <SocialIcon platform={l.platform} />
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
