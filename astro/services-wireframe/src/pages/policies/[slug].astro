---
// Legal pages (Privacy Policy, Terms & Conditions, Accessibility Statement): the Wix Studio legal dummy text, held in the
// LegalPages CMS collection so the owner edits it there. No Wix SEO item type, so the page sets its own <title>.
// Plain reading pages: no entrance or typing animations.
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getLegalPage } from "../../lib/content";
const page = await getLegalPage(Astro.params.slug!);
if (!page) return Astro.rewrite("/404");
---
<SiteLayout title={page.title} motion={false}>
  <section class="pt-(--gutter) pb-(--section-y)">
    <div class="wrap">
      <h1 class="text-display">{page.title}</h1>
      <div class="prose-site mt-10" set:html={page.body} />
    </div>
  </section>
</SiteLayout>
