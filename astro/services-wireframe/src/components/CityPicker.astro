---
// The header city picker. The trigger shows the chosen city and the phone of its first location. It opens one panel under the header:
// city tabs (the footer's underline tabs, with each city's location count) over that city's locations (name, address, phone).
// The chosen city is kept in a cookie: the server renders the header, the footer tabs and the services offered there from it.
// Choosing another tab reloads the page with that city. With no cookie the first city (San Francisco) is used.
import { getLocations, citiesOf, addressLines, telHref } from "../lib/cms";
import { getCurrentCity, CITY_COOKIE } from "../lib/city";
const cities = citiesOf(await getLocations());
const current = await getCurrentCity(Astro);
const first = cities.find((c) => c.city === current) ?? cities[0];
const phoneOf = (c: (typeof cities)[number]) => c.locations.find((l) => l.phone)?.phone ?? "";
---
{first && (
  <div class="city" data-city-root data-cookie={CITY_COOKIE} data-current={first.city}>
    <div class="flex items-center gap-1">
      <button type="button" class="city-btn" id="city-btn" aria-expanded="false" aria-controls="city-panel">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 14.5s4.75-4.2 4.75-8.1a4.75 4.75 0 1 0-9.5 0c0 3.9 4.75 8.1 4.75 8.1Z" stroke="currentColor" stroke-width="1.4" /><circle cx="8" cy="6.4" r="1.7" stroke="currentColor" stroke-width="1.4" /></svg>
        <span class="sr-only">City: </span><span data-city-name>{first.city}</span>
        <svg class="city-chev" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      {phoneOf(first) && <a class="city-phone hidden xl:inline-flex" data-city-phone href={telHref(phoneOf(first))}>{phoneOf(first)}</a>}
    </div>

    <div id="city-panel" class="city-panel" hidden>
      <div class="wrap py-4 md:py-6">
        <div class="rounded-(--radius-sheet) border border-border p-5 md:p-8">
          <p class="font-display text-h3 font-medium">Our Locations</p>
          <div role="tablist" aria-label="Cities" class="ft-tablist mt-4">
            {cities.map((c, i) => (
              <button type="button" role="tab" id={`city-tab-${i}`} aria-controls={`city-tabpanel-${i}`} aria-selected={c.city === first.city ? "true" : "false"} tabindex={c.city === first.city ? 0 : -1} data-city={c.city} class="ft-tab gap-1.5">
                {c.city} <span class="text-muted-foreground">{c.locations.length}</span>
              </button>
            ))}
          </div>
          {cities.map((c, i) => (
            <div role="tabpanel" id={`city-tabpanel-${i}`} aria-labelledby={`city-tab-${i}`} data-city-list={c.city} data-phone={phoneOf(c)} hidden={c.city !== first.city}>
              <ul class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
                {c.locations.map((l) => (
                  <li class="pt-5">
                    <a href={`/locations/${l.slug}`} class="city-loc">{l.title}</a>
                    <p class="mt-1 text-sm text-muted-foreground">{addressLines(l.address).join(", ")}</p>
                    {l.phone && <a href={telHref(l.phone)} class="mt-1 inline-flex min-h-11 items-center gap-2 text-sm text-foreground underline underline-offset-[0.2em] transition-opacity hover:opacity-55">
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5.6 2.5 4 2.2 2.4 3.8c0 5.4 4.4 9.8 9.8 9.8l1.6-1.6-.3-1.6-2.6-1-1.3 1.3a7 7 0 0 1-3.3-3.3L7.6 6 6.6 3.4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
                      {l.phone}
                    </a>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
)}

<script>
  const root = document.querySelector<HTMLElement>("[data-city-root]");
  if (root) {
    const btn = root.querySelector<HTMLButtonElement>("#city-btn")!;
    const panel = root.querySelector<HTMLElement>("#city-panel")!;
    const KEY = "site:city";
    const setOpen = (open: boolean) => { panel.hidden = !open; btn.setAttribute("aria-expanded", String(open)); };
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab][data-city]")];
    const COOKIE = root.dataset.cookie || "city";
    const current = root.dataset.current || "";
    const writeCity = (city: string) => {
      document.cookie = `${COOKIE}=${encodeURIComponent(city)}; path=/; max-age=31536000; samesite=lax`;
      try { localStorage.setItem(KEY, city); } catch {}
    };
    // Choosing a city: the services on the page depend on it (not every service is offered everywhere), so the page reloads
    // with the new city; the server reads it from the cookie.
    const keep = (city: string, focus = false) => {
      const t = tabs.find((x) => x.dataset.city === city);
      if (!t) return;
      tabs.forEach((x) => { const on = x === t; x.setAttribute("aria-selected", String(on)); x.tabIndex = on ? 0 : -1; });
      if (focus) t.focus();
      if (city === current) return;
      writeCity(city);
      window.location.reload();
    };
    // A city chosen on an earlier visit (before the cookie existed) is carried over once.
    try {
      const saved = localStorage.getItem(KEY);
      if (!document.cookie.split("; ").some((c) => c.startsWith(`${COOKIE}=`))) {
        if (saved && saved !== current && tabs.some((t) => t.dataset.city === saved)) { writeCity(saved); window.location.reload(); }
        else writeCity(current);
      }
    } catch { /* storage blocked (private mode): the cookie alone carries the city */ }
    btn.addEventListener("click", () => setOpen(panel.hidden));
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => keep(t.dataset.city!));
      t.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const n = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        keep(n.dataset.city!, true);
      });
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) { setOpen(false); btn.focus(); } });
    document.addEventListener("click", (e) => { if (!panel.hidden && !root.contains(e.target as Node)) setOpen(false); });
  }
</script>
