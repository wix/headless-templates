---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { BUSINESS_NAME } from "../utils/constants";

const features = [
  {
    title: "Online Booking",
    description: "Book appointments online 24/7 without having to call or email.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>`,
  },
  {
    title: "Instant Confirmation",
    description: "Receive immediate confirmation for your scheduled appointments.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
  },
  {
    title: "Easy Rescheduling",
    description: "Need to reschedule? No problem, change your appointment with ease.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
  },
];
---

<Layout>
  <div class="min-h-screen">
    <Navbar />

    <main>
      <section class="brand-gradient pt-40 pb-24 px-4">
        <div class="max-w-7xl mx-auto text-center">
          <div class="animate-fade-up">
            <p class="eyebrow mb-4">Online Scheduling</p>
            <h1 class="text-5xl md:text-7xl font-normal tracking-tight leading-[1.05] mb-6 text-foreground">
              Schedule with {BUSINESS_NAME}
            </h1>
          </div>
          <div class="animate-fade-up" style="animation-delay: 100ms;">
            <p class="text-lg text-foreground/60 mb-8 max-w-2xl mx-auto">
              Book your next appointment in just a few clicks — simple, fast, and convenient scheduling.
            </p>
          </div>
          <div class="animate-fade-up" style="animation-delay: 200ms;">
            <a href="/schedule" class="inline-block py-3.5 px-9 bg-primary text-white pill font-semibold hover:bg-primary/90 transition-colors">
              Book an Appointment
            </a>
          </div>
        </div>
      </section>

      <section class="py-24 bg-white px-4">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-16">
            <p class="eyebrow mb-4">Why Book With Us</p>
            <h2 class="text-3xl md:text-4xl font-normal">A seamless experience, start to finish</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            {features.map((feature, index) => (
              <div class="text-center animate-fade-up" style={`animation-delay: ${index * 100 + 200}ms`}>
                <div class="w-12 h-12 rounded-full brand-gradient-card mx-auto mb-5 flex items-center justify-center">
                  <div class="text-primary" set:html={feature.icon} />
                </div>
                <h3 class="text-lg font-semibold mb-3">{feature.title}</h3>
                <p class="text-sm text-foreground/55 leading-relaxed">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-primary py-24 px-10 text-center">
        <p class="text-2xl md:text-4xl font-normal italic text-white/60 leading-snug max-w-3xl mx-auto">
          "Booking an appointment should take a minute, not a phone call."
        </p>
      </section>

      <section class="py-24 px-4 text-center">
        <div class="max-w-7xl mx-auto">
          <div class="animate-fade-up">
            <h2 class="text-3xl md:text-4xl font-normal mb-4">Ready to book your appointment?</h2>
          </div>
          <div class="animate-fade-up" style="animation-delay: 100ms;">
            <p class="text-foreground/55 mb-8 max-w-2xl mx-auto">
              Our online scheduling system makes it easy to find a time that works for you.
            </p>
          </div>
          <div class="animate-fade-up" style="animation-delay: 200ms;">
            <a href="/schedule" class="inline-block py-3.5 px-9 bg-primary text-white pill font-semibold hover:bg-primary/90 transition-colors">
              Schedule Now
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>