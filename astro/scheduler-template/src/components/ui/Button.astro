---
interface Props {
  variant?: 'default' | 'outline-solid' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  disabled?: boolean;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  'data-slot-index'?: string;
}

const {
  variant = 'default',
  size = 'md',
  class: className = '',
  disabled = false,
  id,
  type = 'button',
  'data-slot-index': slotIndex,
  ...rest
} = Astro.props;

const variants = {
  default: 'bg-primary text-white hover:bg-primary/90',
  outline: 'bg-transparent border-[1.5px] border-primary text-primary hover:bg-primary/5',
  ghost: 'bg-transparent hover:bg-gray-100'
};

const sizes = {
  sm: 'text-xs py-1.5 px-4',
  md: 'text-sm py-3 px-7',
  lg: 'text-base py-3.5 px-9'
};

const baseClasses = 'pill font-semibold transition-colors focus:outline-hidden focus:ring-2 focus:ring-primary/50';
const disabledClasses = disabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer';
---

<button
  id={id}
  type={type}
  class:list={[baseClasses, variants[variant], sizes[size], disabledClasses, className]}
  disabled={disabled}
  data-slot-index={slotIndex}
  {...rest}
>
  <slot />
</button>