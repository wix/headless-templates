---
import SiteLayout from "../layouts/SiteLayout.astro";
import { PRODUCT_URL } from "../lib/site";
---
<SiteLayout title="Page not found">
  <section class="wrap section flex min-h-[calc(100svh-var(--header-h))] flex-col items-center justify-center text-center">
    <h1 class="text-h2">This page isn't here</h1>
    <p class="mx-auto mt-4 max-w-[40ch] text-muted-foreground">The link may be old or mistyped. Head back home, or go straight to the product.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={PRODUCT_URL} class="btn btn-primary">Buy Now</a>
      <a href="/" class="btn btn-secondary">Back to home</a>
    </div>
  </section>
</SiteLayout>
