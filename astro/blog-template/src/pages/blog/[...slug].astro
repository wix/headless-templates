---
import Layout from '../../layouts/Layout.astro';
import RicosContent from '../../components/RicosContent.astro';
import { getPostBySlug, getCoverUrl, formatDate, readingTime } from '../../lib/blog';

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;

if (!post) {
  return Astro.redirect('/blog');
}

const cover = getCoverUrl(post, 1600, 700);

const DARK = '#1a1d2e';
---

<Layout title={post.title} activePage="blog">
  <!-- Hero image or gradient -->
  <div style="width:100%;height:480px;overflow:hidden;position:relative">
    {cover
      ? <img src={cover} alt={post.title} style="width:100%;height:100%;object-fit:cover" />
      : <div style="width:100%;height:100%;background:linear-gradient(135deg,#dde9de 0%,#eaedf4 55%,#e0dced 100%)"></div>
    }
  </div>

  <!-- Article -->
  <article style="max-width:760px;margin:0 auto;padding:60px 24px 100px">
    <!-- Meta -->
    <p style="font-size:12px;font-weight:700;letter-spacing:0.1em;opacity:0.45;margin-bottom:20px">
      {formatDate(post.firstPublishedDate)} · {readingTime(post)}
    </p>

    <h1 style={`font-size:clamp(32px,4vw,56px);font-weight:500;line-height:1.1;letter-spacing:-0.02em;color:${DARK};margin-bottom:32px`}>
      {post.title}
    </h1>

    {post.excerpt && (
      <p style="font-size:18px;line-height:1.7;color:#6b7280;margin-bottom:40px;padding-bottom:40px;border-bottom:1px solid #e5e7eb">
        {post.excerpt}
      </p>
    )}

    <!-- Body -->
    <RicosContent richContent={post.richContent as any} />
  </article>

  <!-- Back link -->
  <div style="text-align:center;padding:0 0 80px">
    <a href="/blog" style={`display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:${DARK};border:1.5px solid ${DARK};border-radius:24px;padding:11px 24px`}>
      ← Back to Blog
    </a>
  </div>
</Layout>
