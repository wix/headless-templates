---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { queryAllPosts, getCoverUrl, formatDate } from '../lib/blog';

const allPosts = await queryAllPosts();
const featured = allPosts[0] ?? null;
const gridPosts = allPosts.slice(1, 5);

const DARK = '#1a1d2e';
const GRAD = 'linear-gradient(135deg, #dde9de 0%, #eaedf4 55%, #e0dced 100%)';
const CARD_GRAD2 = 'linear-gradient(140deg, #e8eddf 0%, #dde4ec 100%)';
const grads = [
  'linear-gradient(140deg,#e4ede6 0%,#d8e0ec 100%)',
  'linear-gradient(140deg,#e8eddf 0%,#dde4ec 100%)',
  'linear-gradient(140deg,#e2e8f0 0%,#e8e4ec 100%)',
  'linear-gradient(140deg,#deeae0 0%,#e4e0ec 100%)',
];
---

<Layout title="Blog" activePage="home">
  <!-- Hero -->
  <section class="hero-section" style={`background:${GRAD};min-height:85vh;display:flex;align-items:flex-end;padding:80px 24px 80px max(24px,calc((100vw - 1280px)/2 + 24px));position:relative;overflow:hidden`}>
    <div style="max-width:640px;position:relative;z-index:1">
      <p style="font-size:13px;font-weight:600;letter-spacing:0.1em;opacity:0.5;margin-bottom:20px">WELCOME TO THE BLOG TEMPLATE</p>
      <h1 style="font-size:clamp(48px,6vw,88px);font-weight:400;line-height:1.05;letter-spacing:-0.02em">
        Start Blogging<br />With This Template
      </h1>
      <a href="/blog" style={`display:inline-block;margin-top:36px;padding:14px 32px;background:${DARK};color:#fff;border-radius:24px;font-size:15px;font-weight:500`}>
        Explore Posts
      </a>
    </div>
  </section>

  <!-- Featured + grid -->
  <section style={`padding:60px 24px 60px max(24px,calc((100vw - 1280px)/2 + 24px));max-width:${1280+48}px;margin-right:auto`}>
    {allPosts.length === 0 ? (
      <div style="text-align:center;padding:80px 0;opacity:0.4">
        <p style="font-size:18px">No posts yet — check back soon.</p>
      </div>
    ) : (
      <div class="hero-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start">
        <!-- Featured -->
        {featured && (
          <a href={`/blog/${featured.slug}`} style="display:block;position:relative;text-decoration:none">
            <div style="width:100%;aspect-ratio:4/5;overflow:hidden;border-radius:2px">
              {getCoverUrl(featured)
                ? <img src={getCoverUrl(featured)!} alt={featured.title} style="width:100%;height:100%;object-fit:cover" />
                : <div style={`width:100%;height:100%;background:${grads[0]}`}></div>
              }
            </div>
            <div style="position:absolute;bottom:16px;left:16px;right:16px;background:#fff;border-radius:2px;padding:12px 16px;box-shadow:0 2px 12px rgba(0,0,0,0.08)">
              <p style="font-size:11px;font-weight:700;letter-spacing:0.08em;opacity:0.45;margin-bottom:4px">
                FEATURED · {formatDate(featured.firstPublishedDate)}
              </p>
              <p style="font-size:15px;font-weight:600;line-height:1.3">{featured.title}</p>
            </div>
          </a>
        )}
        <!-- Right grid -->
        <div>
          <div class="mini-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
            {gridPosts.map((post, i) => <PostCard post={post} index={i + 1} />)}
            {gridPosts.length < 4 && Array.from({ length: 4 - gridPosts.length }).map((_, i) => (
              <div style={`aspect-ratio:4/3;border-radius:2px;background:${grads[(i + gridPosts.length + 1) % grads.length]}`}></div>
            ))}
          </div>
          <div style="text-align:right;margin-top:20px">
            <a href="/blog" style={`font-size:13px;font-weight:500;border:1px solid #d1d5db;border-radius:24px;padding:8px 20px;color:${DARK}`}>
              All Posts
            </a>
          </div>
        </div>
      </div>
    )}
  </section>

  <!-- Quote strip -->
  <section style={`background:${DARK};padding:80px 24px;text-align:center`}>
    <p style="font-size:clamp(24px,3.5vw,48px);font-weight:400;font-style:italic;color:#6b7080;line-height:1.3;max-width:900px;margin:0 auto">
      "This is the blog template's space to introduce<br />your publication and what it has to offer"
    </p>
    <p style="margin-top:28px;font-size:14px;color:#6b7080;font-weight:500">Full Name</p>
  </section>

  <!-- 3-col post row -->
  <section style="padding:60px max(24px,calc((100vw - 1280px)/2 + 24px))">
    <div class="grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px">
      {allPosts.slice(0, 3).map((post, i) => <PostCard post={post} index={i + 2} />)}
      {allPosts.length < 3 && Array.from({ length: 3 - allPosts.length }).map((_, i) => (
        <div style={`aspect-ratio:4/3;border-radius:2px;background:${grads[(i + allPosts.length + 2) % grads.length]}`}></div>
      ))}
    </div>
  </section>

  <!-- Brand banner -->
  <section style={`background:${GRAD};min-height:520px;display:flex;align-items:center;justify-content:flex-end;padding:80px max(24px,calc((100vw - 1280px)/2 + 24px)) 80px 24px;position:relative;overflow:hidden`}>
    <div style="max-width:380px;text-align:left">
      <h2 style="font-size:clamp(28px,3.5vw,44px);font-weight:500;line-height:1.2;letter-spacing:-0.01em">
        This blog template's space<br />to promote your publication.
      </h2>
      <a href="/about" style={`display:inline-block;margin-top:28px;padding:12px 28px;background:none;color:${DARK};border:1.5px solid ${DARK};border-radius:24px;font-size:14px;font-weight:500`}>
        Our Story
      </a>
    </div>
  </section>

  <!-- Promo + CTA -->
  <section class="promo-grid" style={`background:#f7f8fc;padding:80px max(24px,calc((100vw - 1280px)/2 + 24px)) 80px 24px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;min-height:420px`}>
    <div style={`height:100%;min-height:280px;border-radius:2px;background:${CARD_GRAD2}`}></div>
    <div>
      <p style="font-size:clamp(20px,2.5vw,32px);font-weight:500;line-height:1.4">
        This blog template's space to promote your publication and its content.
      </p>
      <a href="/blog" style={`display:inline-block;margin-top:28px;padding:13px 28px;background:${DARK};color:#fff;border-radius:24px;font-size:14px;font-weight:600`}>
        Read More
      </a>
    </div>
  </section>

  <!-- Image strip -->
  <section class="grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:0">
    {grads.map(g => <div style={`aspect-ratio:1;background:${g}`}></div>)}
  </section>

  <!-- Newsletter -->
  <section class="newsletter-grid" style="background:#f7f8fc;padding:80px max(24px,calc((100vw - 1280px)/2 + 24px));display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center">
    <p style="font-size:17px;line-height:1.7;color:#374151">
      This blog template's space to promote your email newsletter. Encourage people to subscribe here.
    </p>
    <div>
      <label style="font-size:13px;font-weight:600;display:block;margin-bottom:8px">Email *</label>
      <input type="email" placeholder="Enter your email address" style="width:100%;padding:12px 16px;border:1px solid #d1d5db;border-radius:4px;font-size:14px;background:#fff" />
      <label style="display:flex;align-items:center;gap:8px;margin-top:12px;font-size:13px;cursor:pointer">
        <input type="checkbox" style="width:14px;height:14px" />
        I agree to receive marketing emails *
      </label>
      <button type="button" style={`margin-top:16px;padding:12px 32px;background:${DARK};color:#fff;border:none;border-radius:4px;font-size:14px;font-weight:600;cursor:pointer`}>
        Subscribe
      </button>
    </div>
  </section>
</Layout>
