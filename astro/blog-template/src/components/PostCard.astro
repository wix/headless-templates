---
import { getCoverUrl, formatDate, readingTime, type Post } from '../lib/blog';
interface Props { post: Post; index?: number; }
const { post, index = 0 } = Astro.props;
const cover = getCoverUrl(post, 600, 400);

const DARK = '#1a1d2e';
const grads = [
  'linear-gradient(140deg,#e4ede6 0%,#d8e0ec 100%)',
  'linear-gradient(140deg,#e8eddf 0%,#dde4ec 100%)',
  'linear-gradient(140deg,#e2e8f0 0%,#e8e4ec 100%)',
  'linear-gradient(140deg,#deeae0 0%,#e4e0ec 100%)',
];
const bg = grads[index % grads.length];
---

<a href={`/blog/${post.slug}`} style="display:block;text-align:left;text-decoration:none">
  <div style="width:100%;aspect-ratio:4/3;overflow:hidden;border-radius:2px">
    {cover
      ? <img src={cover} alt={post.title} style="width:100%;height:100%;object-fit:cover" loading="lazy" />
      : <div style={`width:100%;height:100%;background:${bg}`}></div>
    }
  </div>
  <p style="margin-top:12px;font-size:11px;font-weight:700;letter-spacing:0.1em;opacity:0.45">
    {formatDate(post.firstPublishedDate)} · {readingTime(post)}
  </p>
  <p style={`margin-top:6px;font-size:16px;font-weight:600;line-height:1.3;color:${DARK}`}>{post.title}</p>
  {post.excerpt && (
    <p style="margin-top:6px;font-size:14px;line-height:1.6;color:#6b7280;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
      {post.excerpt}
    </p>
  )}
</a>
