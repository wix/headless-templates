---
// Home services: the page's accent block.
//   The heading scrolls away first; then a pinned stage fills the screen under the site header (with the
//   side padding --gutter all round) and vertical scroll moves the row of full-height service cards sideways. Each photo drifts
//   inside its frame (parallax).
// Card (the Conwest project card, inverted so text never sits on the photo at rest): a white card; the photo is an inset,
//   rounded frame over most of the card, with chips (category, duration, price); below it, on white, the name. Hover (fast): the
//   photo's mask closes to a smaller frame while the image settles (scale 1.08 → 1.02), the text panel rises with it and the
//   service description fades in under the name; the full-width black "Book Now" pill slides up out of its mask.
//   Touch screens: the resting layout with the pill always shown. No outlines, no dark overlay on photos.
// Phones and reduced motion: a native swipe rail with snap.
import { formatDuration, formatPrice, type ServiceDTO } from "../lib/services";
interface Props { title: string; ctaLabel: string; bookLabel?: string; services: ServiceDTO[] }
const { title, ctaLabel, bookLabel = "Book Now", services } = Astro.props;
const arrow = `<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9h12M10 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<section class="svc bg-secondary on-grey" aria-labelledby="services-title" data-svc>
  <div class="svc__intro">
    <div class="wrap svc__head">
      <h2 id="services-title" class="text-h2" data-split>{title}</h2>
    </div>
  </div>
  <div class="svc__pin">
    <div class="svc__viewport">
      <ol class="svc__track">
        {services.map((s, i) => (
          <li class="svc__item" style={`--i:${i}`}>
            <a href={`/book/time?service=${encodeURIComponent(s.slug)}`} class="svc-card" aria-label={`${s.name}, ${formatPrice(s.price)}: ${bookLabel}`}>
              <div class="svc-card__media">
                {s.image && <img src={s.image.replace(/\/v1\/fill\/w_\d+,h_\d+/, "/v1/fill/w_1200,h_1500")} alt="" width="1200" height="1500" loading="lazy" decoding="async" />}
              </div>
              <div class="svc-card__tags">
                {s.category?.name && <span class="svc-card__tag">{s.category.name}</span>}
                <span class="svc-card__tag">{formatDuration(s.minutes)}</span>
              </div>
              <div class="svc-card__text">
                <h3 class="svc-card__name">{s.name}</h3>
                {s.description && <p class="svc-card__about">{s.description}</p>}
              </div>
              <span class="svc-card__cta" aria-hidden="true"><span class="svc-card__book btn btn-primary"><span>{bookLabel}</span><span class="svc-card__price">{formatPrice(s.price)}</span></span></span>
            </a>
          </li>
        ))}
        <li class="svc__item svc__item--more" style={`--i:${services.length}`}>
          <a href="/book" class="svc-more">
            <span class="svc-more__label">{ctaLabel}</span>
            <span class="svc-more__go" set:html={arrow} />
          </a>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .svc { position: relative; padding-bottom: var(--section-y); overflow: clip; }
  .svc__intro { padding-top: var(--section-y); }
  .svc__head { display: grid; gap: 1.5rem; align-items: end; justify-items: start; }
  @media (min-width: 1024px) { .svc__head { grid-template-columns: 1fr auto; } }

  .svc__viewport { margin-top: clamp(2rem, 4vw, 3.5rem); }
  .svc__track {
    --card-w: clamp(16.5rem, 78vw, 22rem);
    display: grid; grid-auto-flow: column; grid-auto-columns: var(--card-w); gap: var(--gutter);
    margin: 0; padding: 0 var(--gutter); list-style: none;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none;
  }
  .svc__track::-webkit-scrollbar { display: none; }
  .svc__item { scroll-snap-align: start; }
  /* tablet and phone: a compact row of cards the visitor swipes sideways (no scroll pinning) */
  @media (max-width: 1023px) {
    .svc__track { --card-w: clamp(15rem, 70vw, 19rem); overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
    .svc .svc-more { min-height: 26rem; }
    /* no hover here: every card is shown open — the name, three lines of the description and Book Now with the price */
    .svc .svc-card { min-height: 26rem; --media-bottom: var(--hover, 52%); }
    .svc .svc-card__text { bottom: calc(var(--card-pad) * 2 + var(--cta-h)); }
    .svc .svc-card__about { -webkit-line-clamp: 3; max-height: 40em; margin-top: 0.75rem; opacity: 1; transform: none; }
    .svc .svc-card__cta { clip-path: none; }
    .svc .svc-card__book { transform: none; }
    .svc .svc-card__media img { scale: 1.02; }
  }

  .svc-card {
    --card-pad: clamp(1.125rem, 1.6vw, 1.625rem);   /* text and chips */
    --frame: 8px;                                     /* the photo's inset at rest */
    --media-bottom: var(--rest, 24%);                 /* the white text panel below the photo, at rest: 24%, or more for a long name (set by the script) */
    --cta-h: 3.25rem;
    --open: 420ms cubic-bezier(.22, .61, .36, 1);     /* hover in */
    --close: 300ms cubic-bezier(.23, 1, .32, 1);      /* hover out */
    position: relative; display: block; height: 100%; min-height: 30rem; overflow: hidden; isolation: isolate;
    border-radius: 18px; background: var(--color-background); color: var(--color-foreground); text-decoration: none;
  }
  .svc-card__media {
    position: absolute; inset: 0; overflow: hidden; background: var(--color-muted);
    clip-path: inset(var(--frame) var(--frame) var(--media-bottom) var(--frame) round 12px);
    transition: clip-path var(--close);
  }
  .svc-card__media img {
    position: absolute; inset: -4% -10%; width: 120%; height: 108%; max-width: none; object-fit: cover;
    transform: translate3d(var(--px, 0%), 0, 0); scale: 1.08; translate: 0 0; transition: scale var(--close), translate var(--close);
  }
  .svc-card__tags { position: absolute; top: calc(var(--frame) + var(--card-pad) - 0.25rem); left: calc(var(--frame) + var(--card-pad) - 0.25rem); right: var(--card-pad); z-index: 1; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .svc-card__tag { display: inline-flex; align-items: center; min-height: 2.125rem; padding-inline: 0.9375rem; border-radius: 9999px; background: var(--color-background); font-size: var(--text-sm); line-height: 1; white-space: nowrap; }
  .svc-card__text {
    position: absolute; z-index: 1; left: var(--card-pad); right: var(--card-pad);
    top: calc(100% - var(--media-bottom) + var(--card-pad)); bottom: var(--card-pad);
    display: flex; flex-direction: column; transition: top var(--close);
  }
  /* the full description: hidden at rest, fades in under the name on hover */
  .svc-card__about {
    margin: 0; max-width: 34ch; max-height: 0; opacity: 0; transform: translate3d(0, 10px, 0); overflow: hidden;
    font-size: var(--text-base); line-height: 1.5; color: var(--color-muted-foreground);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; /* every card shows at most five lines */
    transition: opacity 180ms var(--ease-site), transform 180ms var(--ease-site), max-height var(--close), margin var(--close);
  }
  .svc-card__name {
    margin: 0; font-family: var(--font-display); font-weight: 500; line-height: 1.05; letter-spacing: -0.03em; text-wrap: balance;
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem); transition: font-size var(--close), letter-spacing var(--close);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; /* at most two lines */
  }
  /* "Book Now": unchanged — a full-width black pill at the foot of the card, sliding up out of a mask on hover. */
  .svc-card__cta { position: absolute; z-index: 2; inset: auto var(--card-pad) var(--card-pad); display: block; overflow: hidden; border-radius: 9999px; pointer-events: none; }
  .svc-card__book {
    display: flex; width: 100%; min-height: var(--cta-h); justify-content: space-between; padding: 0.375rem 0.375rem 0.375rem 1.5rem;
    background: var(--color-foreground) !important; color: var(--color-background) !important; box-shadow: none !important;
  }
  /* the price, in a dark-grey pill inside the black button, on the right */
  .svc-card__price { display: inline-flex; align-items: center; align-self: stretch; padding-inline: 1.125rem; border-radius: 9999px; background: #3a3a3a; color: #fff; font-variant-numeric: tabular-nums; }
  @media (hover: hover) and (pointer: fine) {
    .svc-card__book { transform: translate3d(0, 105%, 0); transition: transform 380ms cubic-bezier(.23, 1, .32, 1); }
    .svc-card__cta { clip-path: inset(100% 0 0 0 round 9999px); transition: clip-path 380ms cubic-bezier(.23, 1, .32, 1); }
    .svc-card:hover .svc-card__book, .svc-card:focus-visible .svc-card__book { transform: none; }
    .svc-card:hover .svc-card__cta, .svc-card:focus-visible .svc-card__cta { clip-path: inset(0 0 0 0 round 9999px); }
    /* the photo's mask closes further (a smaller frame on top); the image settles; the text panel rises with it */
    .svc-card:hover, .svc-card:focus-visible { --media-bottom: var(--hover, 44%); }
    .svc-card:hover .svc-card__media, .svc-card:focus-visible .svc-card__media { transition: clip-path var(--open); }
    .svc-card:hover .svc-card__text, .svc-card:focus-visible .svc-card__text { bottom: calc(var(--card-pad) * 2 + var(--cta-h)); transition: top var(--open); }
    .svc-card:hover .svc-card__media img, .svc-card:focus-visible .svc-card__media img { scale: 1.02; translate: 0 -1.25%; transition: scale var(--open), translate var(--open); }
    /* the description appears under the name */
    .svc-card:hover .svc-card__about, .svc-card:focus-visible .svc-card__about {
      max-height: 40em; margin-top: 1rem; opacity: 1; transform: none;
      transition: opacity 260ms var(--ease-site) 120ms, transform 340ms cubic-bezier(.23, 1, .32, 1) 120ms, max-height var(--open), margin var(--open);
    }
  }
  /* touch: the pill is always shown, so the text panel ends above it */
  @media not ((hover: hover) and (pointer: fine)) {
    .svc-card { --media-bottom: var(--touch, 32%); }
    .svc-card__text { bottom: calc(var(--card-pad) * 2 + var(--cta-h)); }
  }

  /* "See all services": the same type as the card names and the same inner padding; the arrow sits bottom-left. */
  .svc-more {
    --card-pad: clamp(1.125rem, 1.6vw, 1.625rem);
    position: relative; display: flex; align-items: flex-start; height: 100%; min-height: 20rem; padding: var(--card-pad);
    border-radius: 18px; background: var(--color-background); color: var(--color-foreground); text-decoration: none;
    transition: background-color 260ms var(--ease-site), color 260ms var(--ease-site);
  }
  .svc-more__label { font-family: var(--font-display); font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.03em; text-wrap: balance; }
  .svc-more__go {
    position: absolute; left: var(--card-pad); bottom: var(--card-pad); display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 9999px;
    background: var(--color-foreground); color: var(--color-background);
    transition: background-color 260ms var(--ease-site), color 260ms var(--ease-site), rotate 420ms cubic-bezier(.23, 1, .32, 1);
  }
  .svc-more:hover { background: var(--color-foreground); color: var(--color-background); }
  .svc-more:hover .svc-more__go { background: var(--color-background); color: var(--color-foreground); rotate: -45deg; }

  /* ── Pinned full-screen stage (tablet/desktop with motion) ── */
  .svc[data-pin="on"] { padding-bottom: 0; height: var(--svc-h, 300vh); }
  .svc[data-pin="on"] .svc__pin {
    position: sticky; top: var(--header-h); height: calc(100svh - var(--header-h)); padding-block: var(--gutter);
  }
  .svc[data-pin="on"] .svc__viewport { height: 100%; margin-top: 0; overflow: hidden; }
  .svc[data-pin="on"] .svc__track {
    /* a card is as tall as the stage; its width keeps the photo near 4:5 and never exceeds the screen */
    --card-h: calc(100svh - var(--header-h) - 2 * var(--gutter));
    --card-w: min(calc(var(--card-h) * 0.72), calc(100vw - 2 * var(--gutter)));
    height: 100%; grid-auto-rows: 100%; overflow: visible; scroll-snap-type: none; width: max-content;
    transform: translate3d(var(--svc-x, 0px), 0, 0); will-change: transform;
  }
  /* cards rise in, staggered, as the stage arrives */
  :global(html.has-motion) .svc[data-pin="on"] .svc__item { opacity: var(--in, 0); transform: translate3d(0, calc((1 - var(--in, 0)) * 60px), 0); }
</style>

<script>
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  document.querySelectorAll<HTMLElement>("[data-svc]").forEach((el) => {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wide = matchMedia("(min-width: 1024px)"); // the scroll-pinned stage is desktop only; below it the cards swipe
    const intro = el.querySelector<HTMLElement>(".svc__intro")!;
    const pin = el.querySelector<HTMLElement>(".svc__pin")!;
    const track = el.querySelector<HTMLElement>(".svc__track")!;
    const items = [...track.children] as HTMLElement[];
    const cards = [...el.querySelectorAll<HTMLElement>(".svc-card")];
    let travel = 0, hold = 0, ticking = false;

    // The white panel under the photo grows with the text, so a long name (and, on hover, the description and the pill) is
    // never clipped: rest = max(24%, name), hover = max(44%, name + description + pill), touch = max(32%, name + pill).
    const fit = () => {
      cards.forEach((c) => {
        const h = c.offsetHeight; if (!h) return;
        const pad = c.querySelector<HTMLElement>(".svc-card__text")!.offsetLeft || 20; // the text sits --card-pad in from the edge
        const cta = 52;
        const name = c.querySelector<HTMLElement>(".svc-card__name")!;
        const about = c.querySelector<HTMLElement>(".svc-card__about");
        // the name and the description are clamped (2 lines; 5, or 3 below 1024), so measure what shows, not the full text
        const lines = (e: HTMLElement, n: number) => Math.min(e.scrollHeight, Math.ceil(parseFloat(getComputedStyle(e).lineHeight) * n));
        const nameH = lines(name, 2);
        const aboutH = about ? lines(about, Number(getComputedStyle(about).webkitLineClamp) || 5) + 16 : 0;
        c.style.setProperty("--rest", `${Math.max(h * 0.24, nameH + pad * 2 + 4)}px`);
        c.style.setProperty("--hover", `${Math.max(h * 0.44, nameH + aboutH + cta + pad * 3 + 4)}px`);
        c.style.setProperty("--touch", `${Math.max(h * 0.32, nameH + cta + pad * 3 + 4)}px`);
      });
      // below 1024 every card is shown open at once: give them all the tallest panel so the photos line up
      if (!wide.matches) {
        const tallest = Math.max(...cards.map((c) => parseFloat(c.style.getPropertyValue("--hover")) || 0));
        cards.forEach((c) => c.style.setProperty("--hover", `${tallest}px`));
      }
    };
    const layout = () => {
      fit();
      if (reduce || !wide.matches) { delete el.dataset.pin; el.style.removeProperty("--svc-h"); track.style.removeProperty("--svc-x"); return; }
      el.dataset.pin = "on";
      travel = Math.max(0, track.scrollWidth - track.parentElement!.clientWidth);
      hold = innerHeight * 0.2; // a short pause before and after the sideways travel
      el.style.setProperty("--svc-h", `${intro.offsetHeight + pin.offsetHeight + travel + hold * 2}px`);
      frame();
    };
    const frame = () => {
      ticking = false;
      if (el.dataset.pin !== "on") return;
      const top = parseFloat(getComputedStyle(pin).top) || 0;
      const stageTop = el.getBoundingClientRect().top + intro.offsetHeight; // where the stage would be if it did not stick
      const scrolled = top - stageTop;                                       // px scrolled since the stage stuck
      const p = travel > 0 ? clamp((scrolled - hold) / travel) : 0;
      track.style.setProperty("--svc-x", `${(-p * travel).toFixed(1)}px`);
      // entrance: cards rise in as the stage comes up the screen
      const enter = clamp((innerHeight - stageTop) / (innerHeight * 0.8));
      items.forEach((it, i) => it.style.setProperty("--in", clamp(enter * 2.2 - i * 0.12).toFixed(3))); // every card, the last included, lands fully
      // parallax inside each photo
      const vw = innerWidth;
      cards.forEach((c) => {
        const b = c.getBoundingClientRect();
        c.style.setProperty("--px", `${(-(b.left + b.width / 2 - vw / 2) / vw * 8).toFixed(2)}%`);
      });
    };
    const on = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
    addEventListener("scroll", on, { passive: true });
    addEventListener("resize", layout);
    wide.addEventListener("change", layout);
    window.addEventListener("load", layout);
    (document as any).fonts?.ready?.then(layout);
    layout();
  });
</script>
