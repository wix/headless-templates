---
// Legal pages (Terms & Conditions, Privacy Policy, Refund Policy, Accessibility Statement): the Wix Studio legal dummy text,
// held in the LegalPages CMS collection so the owner edits it there. Laid out with the home page's paddings and type.
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getLegalPage } from "../../lib/content";
const page = await getLegalPage(Astro.params.slug!);
if (!page) return new Response(null, { status: 404 });
---
<SiteLayout title={page.title}>
  <section class="page-plain" aria-labelledby="page-title">
    <div class="wrap">
      <h1 id="page-title" class="text-h2" data-split>{page.title}</h1>
      <div class="prose-site page-plain__body" data-reveal set:html={page.body} />
    </div>
  </section>
</SiteLayout>
