---
import { getCoverUrl, formatDate, readingTime, type Post } from '../lib/blog';
interface Props { post: Post; index?: number; }
const { post, index = 0 } = Astro.props;
const cover = getCoverUrl(post, 600, 400);
---

<a href={`/blog/${post.slug}`} class="card">
  <div class="cover">
    {cover
      ? <img src={cover} alt={post.title} loading="lazy" />
      : <div class:list={['fill', `g${index % 4}`]}></div>
    }
  </div>
  <p class="kicker meta">{formatDate(post.firstPublishedDate)} · {readingTime(post)}</p>
  <p class="title">{post.title}</p>
  {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
</a>

<style>
  .card { display: block; }
  .cover { aspect-ratio: 4 / 3; overflow: hidden; border-radius: 2px; }
  .cover img, .fill { width: 100%; height: 100%; object-fit: cover; }
  .meta { margin-top: 12px; font-size: 11px; }
  .title { margin-top: 6px; font-size: 16px; font-weight: 600; line-height: 1.3; }
  .excerpt { margin-top: 6px; font-size: 14px; line-height: 1.6; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
