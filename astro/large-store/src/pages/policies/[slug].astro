---
// Legal pages (Terms, Privacy, Shipping, Refund, Accessibility) from the LegalPages CMS collection —
// the owner edits them in the dashboard; a slug that matches nothing is a 404.
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getLegalPage } from "../../lib/content";

const page = await getLegalPage(Astro.params.slug!);
if (!page) return new Response(null, { status: 404 });
---
<SiteLayout title={String(page.title)}>
  <article class="wrap section">
    <h1 class="text-center text-h2">{page.title}</h1>
    <div class="prose-site mx-auto mt-8 lg:mt-12" set:html={String(page.body ?? "")} />
  </article>
</SiteLayout>
