---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Page Not Found">
  <section class="section bg-secondary">
    <div class="wrap flex flex-col items-center text-center">
      <h1 class="section-title">Page not found</h1>
      <p class="mt-6 max-w-[48ch] text-sm text-muted-foreground">The page you're looking for doesn't exist or has moved.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/service#book" class="btn btn-primary">Book now</a>
        <a href="/" class="btn btn-outline">Back to Home</a>
      </div>
    </div>
  </section>
</SiteLayout>
