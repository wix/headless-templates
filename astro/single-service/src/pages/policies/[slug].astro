---
// Legal pages (Terms & Conditions, Privacy Policy, Refund Policy, Accessibility Statement): the
// Wix Studio legal dummy text, held in the LegalPages CMS collection so the owner edits it there.
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getLegalPage } from "../../lib/content";
const page = await getLegalPage(Astro.params.slug!);
if (!page) return new Response(null, { status: 404 });
---
<SiteLayout title={page.title}>
  <section class="section bg-secondary">
    <div class="wrap">
      <h1 class="section-title">{page.title}</h1>
      <div class="mx-auto mt-10 max-w-[48rem] rounded-sheet bg-background p-6 sm:p-10">
        <div class="prose-site" set:html={page.body} />
      </div>
    </div>
  </section>
</SiteLayout>
