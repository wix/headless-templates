---
// A Wix ITEM PAGE: wixMetadata + <SEO.Tags> are what let the site owner edit this page's title / description / OG in the
// dashboard and register the route in the sitemap. All three SEO pieces are required, exactly as the kit's skeleton has them.
// The page is the store with this product open in place (StoreApp); the catalog fades behind it.
import StoreApp from "../../components/store/StoreApp";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { BUSINESS_NAME } from "../../lib/site";
import { loadStore } from "../../lib/store-data";
import { fetchProductBySlug } from "../../wix/storefront/catalog";
import { WIX_APPS } from "@wix/essentials";
import { SEO } from "@wix/seo/components";
import { loadSEOTagsServiceConfig } from "@wix/seo/services";
import { seoTags } from "@wix/seo";

export const wixMetadata = {
  appDefId: WIX_APPS.checkoutAndOrders.id,
  pageIdentifier: WIX_APPS.checkoutAndOrders.productPageMetadata.pageIdentifier,
  identifiers: { slug: WIX_APPS.checkoutAndOrders.productPageMetadata.identifiers.handle },
};

const slug = Astro.params.slug!;
// Behind Wix's proxy the request URL is the internal one: the public URL arrives on x-wix-forwarded-url.
const forwardedUrl = Astro.request.headers.get("x-wix-forwarded-url");
const pageUrl = forwardedUrl && URL.canParse(forwardedUrl) && /^https?:$/.test(new URL(forwardedUrl).protocol) ? forwardedUrl : Astro.url.href;

let product = null;
let seoTagsServiceConfig = null;
try {
  [product, seoTagsServiceConfig] = await Promise.all([
    fetchProductBySlug(slug),
    loadSEOTagsServiceConfig({ pageUrl, itemType: seoTags.ItemType.STORES_PRODUCT, itemData: { slug } }),
  ]);
} catch (err) {
  console.error("[product page]", slug, err);
  // Guarded: an unhandled SSR throw truncates the response mid-stream.
}
if (!product) return new Response(null, { status: 404 });

const data = await loadStore();
---
<SiteLayout title={product.name} products={data.items}>
  <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />
  <StoreApp client:load data={data} businessName={BUSINESS_NAME} initialUrl={Astro.url.href} />
</SiteLayout>
