---
// The three social glyphs of the footer bar, drawn inline (no icon font, no extra request). 24px grid, currentColor, so the
// colour and hover come from the link. Simple line drawings on purpose: a wireframe, replaced by the owner's brand marks.
interface Props { platform: "instagram" | "tiktok" | "facebook"; size?: number }
const { platform, size = 20 } = Astro.props;
---
{platform === "instagram" && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
  </svg>
)}
{platform === "tiktok" && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14 3.5v11a3.5 3.5 0 1 1-3.5-3.5" /><path d="M14 3.5c.3 2.6 2 4.2 4.5 4.4" />
  </svg>
)}
{platform === "facebook" && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M14.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.6V3.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.4H8.6V13h2.7v8z" />
  </svg>
)}
