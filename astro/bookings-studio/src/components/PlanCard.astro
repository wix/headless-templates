---
// A membership plan, pricing-table style: name, a large price with "/mo", a line of description, the action slot, then the perks with
// check icons. The featured plan sits in a taller column with a tab on top ("Popular Plan").
import type { PlanDTO } from "../lib/plans";
interface Props { plan: PlanDTO; popular?: boolean; }
const { plan: p, popular = false } = Astro.props;
// Price and billing cycle come from the plan (pricingVariants[0]); "/mo" only when it really bills monthly.
const cycle = p.cycleLabel === "per month" ? "/mo" : p.cycleLabel === "per year" ? "/yr" : p.cycleLabel === "once" ? "" : p.cycleLabel;
// Half of the plan's perks are shown on the card (rounded up).
const perks = p.perks.slice(0, Math.ceil(p.perks.length / 2));
---
<div class="pc-col" data-popular={popular}>
  {popular && <div class="pc-tab"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L4 14h6l-1 8 9-12h-6z"/></svg>Popular Plan</div>}
  <article class="pc-card">
    <h3 class="pc-name">{p.name}</h3>
    <p class="pc-price"><span class="pc-amount">{p.priceLabel}</span>{cycle && <span class="pc-cycle">{cycle}</span>}</p>
    {p.description && <p class="pc-desc">{p.description}</p>}
    <div class="pc-action"><slot /></div>
    {perks.length > 0 && (
      <ul class="pc-perks">
        {perks.map((k) => <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5"/><path d="M8 12.3l2.7 2.7L16 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{k}</span></li>)}
      </ul>
    )}
  </article>
</div>
