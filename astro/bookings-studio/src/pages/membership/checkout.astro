---
// /membership/checkout?plan=<id> — the plan summary in the site's own design (same layout as the booking form). The payment
// itself happens on Wix's hosted Pricing Plans checkout (PlanBuy -> redirects.createRedirectSession), which code cannot restyle.
import SiteLayout from "../../layouts/SiteLayout.astro";
import PlanBuy from "../../components/schedule/PlanBuy";
import { getPlans } from "../../lib/plans";
const plans = await getPlans();
const p = plans.find((x) => x.id === Astro.url.searchParams.get("plan"));
const check = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5"/><path d="M8 12.3l2.7 2.7L16 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<SiteLayout title={p ? `${p.name} checkout` : "Checkout"} hideCta barSpace>
  <div class="flow pb-16 pt-8">
    <a href="/#membership" class="link-btn text-sm">← Back to plans</a>
    {p ? (
      <div>
        <h1 class="mt-6 text-h2">Checkout</h1>
        <p class="mt-4 max-w-[52ch] text-muted-foreground">Review your membership, then continue to secure payment. You will sign in or create an account on the next step.</p>

        <h2 class="mt-10 text-lg font-medium">Membership summary</h2>
        <div class="mt-6 bk-sum">
          <div class="flex items-start justify-between gap-4 px-4 py-4">
            <div class="min-w-0">
              <p class="font-medium leading-snug">{p.name}</p>
              {p.description && <p class="mt-1 text-sm text-muted-foreground">{p.description}</p>}
              <p class="mt-1 text-sm text-muted-foreground">Billed monthly · cancel anytime</p>
            </div>
            <p class="shrink-0 text-sm font-medium">{p.priceLabel} / mo</p>
          </div>
          <div class="flex items-center justify-between gap-4 border-t border-border bg-secondary px-4 py-3 text-sm">
            <span class="text-muted-foreground">Due today</span>
            <span class="font-medium">Total {p.priceLabel}</span>
          </div>
        </div>

        {p.perks.length > 0 && (
          <>
            <h2 class="mt-10 text-lg font-medium">What's included</h2>
            <ul class="pc-perks co-perks mt-6">{p.perks.map((k) => <li><Fragment set:html={check} /><span>{k}</span></li>)}</ul>
          </>
        )}

        <div class="mt-10 co-pay"><PlanBuy client:load planId={p.id} name={p.name} label="Continue to payment" /></div>
        <p class="mt-3 text-sm text-muted-foreground">Prices are in US dollars. Taxes may be added at payment.</p>
      </div>
    ) : (
      <div>
        <h1 class="mt-6 text-h2">Checkout</h1>
        <p class="mt-6 max-w-[52ch] text-lg text-muted-foreground">There is no plan selected. Choose one of the membership plans.</p>
        <a href="/#membership" class="btn btn-primary mt-8">View plans</a>
      </div>
    )}
  </div>
</SiteLayout>
