---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Page Not Found">
  <section class="section on-plain">
    <div class="wrap flex min-h-[50svh] flex-col items-center justify-center text-center">
      <p class="ab2-pill">404</p>
      <h1 class="text-h2 mt-4">Page not found</h1>
      <p class="mt-4 max-w-[48ch] text-muted-foreground">The page you're looking for doesn't exist or has moved.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/#schedule" class="btn btn-primary">View schedule</a>
        <a href="/" class="btn btn-secondary">Back to Home</a>
      </div>
    </div>
  </section>
</SiteLayout>
