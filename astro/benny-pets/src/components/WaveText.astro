---
interface Props {
  text: string;
  class?: string;
  id?: string;
  amplitude?: number;
  stagger?: number;
}

const { text, class: className, id, amplitude = 14, stagger = 45 } = Astro.props;
---

<div
  class={className}
  id={id}
  data-wave
  data-wave-amp={amplitude}
  data-wave-stagger={stagger}
>
  {
    [...text].map((ch, i) =>
      ch === " " ? (
        <span class="wm-space" />
      ) : (
        <span
          class="wm-letter"
          style={`transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1) ${i * 0.03}s`}
        >
          {ch}
        </span>
      ),
    )
  }
</div>
