---
interface Props {
  id: string;
  label: string;
  type?:
    | "text"
    | "email"
    | "tel"
    | "number"
    | "date"
    | "textarea"
    | "select"
    | "radio"
    | "checkbox"
    | "checkbox-group";
  required?: boolean;
  options?: Array<{ value: string; label: string }>;
}

const { id, label, type = "text", required = false, options = [] } = Astro.props;
---

<div class="form-field">
  <label for={id} class="form-label">
    {label}
    {required && <span style="color: var(--error-color);">*</span>}
  </label>

  {
    type === "textarea" ? (
      <textarea id={id} name={id} class="form-textarea" required={required} />
    ) : type === "select" ? (
      <select id={id} name={id} class="form-select" required={required}>
        <option value="">Select an option</option>
        {options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    ) : type === "radio" ? (
      <div class="space-y-3 mt-2">
        {options.map((option) => (
          <div class="flex items-center">
            <input
              type="radio"
              id={`${id}-${option.value}`}
              name={id}
              value={option.value}
              class="form-radio mr-2"
              required={required}
            />
            <label for={`${id}-${option.value}`} class="text-sm">{option.label}</label>
          </div>
        ))}
      </div>
    ) : type === "checkbox-group" ? (
      <div class="space-y-3 mt-2">
        {options.map((option) => (
          <div class="flex items-center">
            <input
              type="checkbox"
              id={`${id}-${option.value}`}
              name={id}
              value={option.value}
              class="form-checkbox mr-2"
              data-multi="true"
            />
            <label for={`${id}-${option.value}`} class="text-sm">{option.label}</label>
          </div>
        ))}
      </div>
    ) : type === "checkbox" ? (
      <div class="flex items-center mt-2">
        <input type="checkbox" id={id} name={id} class="form-checkbox" required={required} />
      </div>
    ) : (
      <input type={type} id={id} name={id} class="form-input" required={required} />
    )
  }
</div>
