---
import { forms } from "@wix/forms";
import { WIX_FORM_ID } from "../utils/constants";
import FormField from "./FormField.astro";

// Fetch the form definition from Wix Forms so the fields below always match
// the form configured in the Wix dashboard.
const wixForm = await forms.getForm(WIX_FORM_ID);

const inputFieldsById = new Map(
  (wixForm.formFields ?? [])
    .filter((field: any) => field.fieldType === "INPUT" && !field.hidden && !!field._id)
    .map((field: any) => [field._id, field]),
);

type RenderableField = {
  id: string;
  type: "text" | "email" | "tel" | "number" | "date" | "textarea" | "select" | "radio" | "checkbox" | "checkbox-group";
  label: string;
  required: boolean;
  options?: Array<{ value: string; label: string }>;
};

function toOptions(rawOptions: any): Array<{ value: string; label: string }> | undefined {
  return rawOptions?.map((option: any) => ({
    value: option.value || option.label || "",
    label: option.label || option.value || "",
  }));
}

// Map a Wix Forms input field definition to the props FormField renders from.
function resolveField(field: any): RenderableField {
  const inputOptions = field.inputOptions ?? {};
  const stringOptions = inputOptions.stringOptions ?? {};
  const id = inputOptions.target || field._id;
  const required = inputOptions.required ?? false;

  // Each field definition carries exactly one of these option objects.
  const kinds: Array<[any, RenderableField["type"]]> = [
    [stringOptions.dropdownOptions, "select"],
    [stringOptions.radioGroupOptions, "radio"],
    [stringOptions.checkboxGroupOptions ?? inputOptions.arrayOptions?.checkboxGroupOptions, "checkbox-group"],
    [inputOptions.numberOptions?.numberInputOptions, "number"],
    [inputOptions.booleanOptions?.checkboxOptions, "checkbox"],
    [stringOptions.phoneInputOptions, "tel"],
    [stringOptions.dateInputOptions, "date"],
  ];
  for (const [opts, type] of kinds) {
    if (opts) {
      return { id, type, label: opts.label || id, required, options: toOptions(opts.options) };
    }
  }

  const type =
    field.identifier === "TEXT_AREA" ? "textarea"
    : stringOptions.validation?.format === "EMAIL" ? "email"
    : "text";
  return { id, type, label: stringOptions.textInputOptions?.label || id, required };
}

// Group fields into sections following the form's step layout when it has one.
const defaultSectionName = wixForm.name || "Registrant information";
const steps = wixForm.steps ?? [];
const sections = steps.length
  ? steps.map((step: any, index: number) => ({
      name: step.name || defaultSectionName || `Section ${index + 1}`,
      fields: (step.layout?.large?.items ?? [])
        .slice()
        .sort((a: any, b: any) => (a.row - b.row) || (a.column - b.column))
        .map((item: any) => inputFieldsById.get(item.fieldId))
        .filter(Boolean)
        .map(resolveField),
    }))
  : [{ name: defaultSectionName, fields: [...inputFieldsById.values()].map(resolveField) }];
---

<form id="registration-form" class="form-container" method="POST">
  {
    sections.map((section, sectionIndex) => (
      <div class="mb-8 border-t border-[#e5e7eb] rounded-sm p-6 bg-white">
        <p class="eyebrow text-[12px] mb-1">{String(sectionIndex + 1).padStart(2, "0")}</p>
        <h2 class="text-primary text-xl font-normal mb-4">{section.name}</h2>

        {section.fields.map((field: RenderableField) => (
          <FormField
            type={field.type}
            id={field.id}
            label={field.label}
            required={field.required}
            options={field.options}
          />
        ))}
      </div>
    ))
  }

  <div id="form-error" class="hidden p-4 mb-4 text-sm text-white rounded-md" style="background-color: var(--error-color);"></div>

  <div class="flex justify-between items-center mt-8">
    <span class="text-muted text-xs">* Required question</span>
    <button type="submit" class="btn">Submit</button>
  </div>
</form>

<script>
  import { submitFormRegistration, type FormValues } from "../utils/form-service";

  const form = document.getElementById("registration-form") as HTMLFormElement;
  const errorContainer = document.getElementById("form-error") as HTMLDivElement;
  const submitButton = form.querySelector("button[type='submit']") as HTMLButtonElement;

  function showError(message: string) {
    errorContainer.textContent = message;
    errorContainer.classList.remove("hidden");
    errorContainer.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  function collectFormValues(): FormValues {
    const data = new FormData(form);
    const values: FormValues = {};

    for (const name of new Set(data.keys())) {
      values[name] = String(data.get(name) ?? "");
    }
    // Number fields submit as numbers.
    for (const input of form.querySelectorAll<HTMLInputElement>('input[type="number"]')) {
      values[input.name] = Number(input.value);
    }
    // Checkbox groups submit an array of the checked values (possibly empty).
    for (const input of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-multi]')) {
      values[input.name] = data.getAll(input.name).map(String);
    }
    // Single checkboxes submit a boolean, whether checked or not.
    for (const input of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not([data-multi])')) {
      values[input.name] = input.checked;
    }
    return values;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorContainer.textContent = "";
    errorContainer.classList.add("hidden");

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = "Submitting...";
    try {
      const result = await submitFormRegistration(collectFormValues());
      if (result.success) {
        window.location.href = "/success";
      } else {
        showError(result.error || "Please check your form and try again.");
      }
    } catch (error) {
      console.error("Error:", error);
      showError("Something went wrong. Please try again later.");
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = "Submit";
    }
  });
</script>
