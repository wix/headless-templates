---
import Layout from "../layouts/Layout.astro";
import { BUSINESS_NAME } from "../utils/constants";
---

<Layout title={`Page Not Found | ${BUSINESS_NAME}`}>
  <div class="max-w-2xl mx-auto text-center py-16">
    <p class="eyebrow mb-4">404</p>
    <h1 class="text-primary text-3xl font-normal mb-6">We couldn't find that page</h1>
    <p class="text-muted mb-8 text-[15px]">
      The page you're looking for might have been removed, had its name changed,
      or is temporarily unavailable.
    </p>
    <a href="/" class="btn">Back to home</a>
  </div>
</Layout>
