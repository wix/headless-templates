---
import Layout from "../layouts/Layout.astro";
import RegistrationForm from "../components/RegistrationForm.astro";
import { BUSINESS_NAME } from "../utils/constants";
---

<Layout title={`Registration | ${BUSINESS_NAME}`}>
  <div class="max-w-4xl mx-auto">
    <div class="mb-10 text-center">
      <p class="eyebrow mb-4">REGISTRATION OPEN</p>
      <h1 class="text-primary text-4xl font-normal tracking-tight mb-4">Register now</h1>
      <p class="text-muted max-w-xl mx-auto text-[15px] leading-relaxed">
        Fill out the form below to complete your registration with {BUSINESS_NAME}.
      </p>
    </div>

    <RegistrationForm />
  </div>
</Layout>
