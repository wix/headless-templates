---
import Layout from "../layouts/Layout.astro";
import TournamentRegistrationForm from "../components/TournamentRegistrationForm.astro";
---

<Layout title="Registration | Business Name">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10 text-center">
      <p class="text-[13px] font-semibold tracking-[0.1em] mb-4" style="color: rgba(26,29,46,0.5);">REGISTRATION OPEN</p>
      <h1 class="text-4xl font-normal tracking-tight mb-4" style="color: #1a1d2e;">Register now</h1>
      <p class="max-w-xl mx-auto text-[15px] leading-relaxed" style="color: rgba(26,29,46,0.6);">
        Fill out the form below to complete your registration with Business Name.
      </p>
    </div>

    <TournamentRegistrationForm />
  </div>
</Layout>