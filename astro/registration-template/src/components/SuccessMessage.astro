---
interface Props {
  title?: string;
  message?: string;
  class?: string;
}

const {
  title = "Success!",
  message = "Your form has been submitted successfully.",
  class: className = "",
} = Astro.props;
---

<div class={`rounded-sm p-10 text-center ${className}`} style="background: var(--grad);">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-12 w-12 mx-auto mb-4"
    style="color: #1a1d2e;"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
    />
  </svg>
  <h3 class="text-2xl font-normal mb-2" style="color: #1a1d2e;">{title}</h3>
  <p class="text-[15px]" style="color: rgba(26,29,46,0.65);">{message}</p>
  <slot />
</div>