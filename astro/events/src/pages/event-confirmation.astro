---
import { wixEventsV2 } from '@wix/events';
import Layout from '../layouts/Layout.astro';
import EventConfirmation from '../components/EventConfirmation.jsx';
import { BUSINESS_NAME } from '../utils/constants';

const eventId = Astro.url.searchParams.get('eventId');
let event = null;

try {
  if (eventId) {
    const raw = await wixEventsV2.getEvent(eventId, { fields: ['TEXTS', 'URLS'] });
    // Serialize only the field the island actually renders.
    event = raw && { title: raw.title };
  }
} catch (err) {
  console.error('Failed to load event for confirmation', err);
}
---
<Layout title={`Confirmed — ${BUSINESS_NAME}`}>
  <EventConfirmation event={event} client:load />
</Layout>
