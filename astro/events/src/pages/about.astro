---
import { members } from '@wix/members';
import Layout from '../layouts/Layout.astro';
import AppIsland from '../components/AppIsland.jsx';
import { BUSINESS_NAME } from '../utils/constants';

let member = null;
try {
  const { member: m } = await members.getCurrentMember({ fieldsets: ['FULL'] });
  member = m ?? null;
} catch {}
---
<Layout title={`Our Story — ${BUSINESS_NAME}`}>
  <AppIsland events={[]} member={member} page="about" client:load />
</Layout>
